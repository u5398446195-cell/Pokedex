"use client";
import Bull from "./Bull.jsx";
import Image from "next/image";
import Axios from "axios";
import { useEffect , useState } from "react";
export default function Home() {
 
  const [ pokemon, setPokemon] = useState(null);
  const [search, setSearch] = useState("");


const FetchPokemon = async () => {
  try {
  const res = await Axios.get(`https://pokeapi.co/api/v2/pokemon/${search.toLowerCase()}`);
  setPokemon(res.data);
  console.log(res.data.sprites.other.showdown.front_default);
  } catch (error) {
    alert("Pokemon not found");
  }
 
};








 // N , PV , h , w
 return (
  <div className="bg-gradient-to-l from-red-500 via-red-600 to-red-900 h-screen w-screen ">
      <div className="flex flex-row gap-12">
      <div className="bg-gradient-to-l from-blue-500 to-blue-800  rounded-full w-25 h-25 "></div>
     <div className="flex flex-row mt-5 gap-4 ">
      <div className="bg-gradient-to-r from-red-500 to-red-700 p-2 w-2 h-2 rounded-full"></div>
       <div className="bg-gradient-to-r from-yellow-500 to-yellow-700 p-2 w-2 h-2 rounded-full"></div>
        <div className="bg-gradient-to-r from-green-500 to-green-700 p-2 w-2 h-2 rounded-full"></div>
          
   
      </div>
 

 </div>
<div className=" w-250 h-150 bg-gradient-to-r from-lime-200 to-lime-500 rounded-md gap-3 border-4 border-neutral-700 font-bold ">

      <div className=" translate-x-[65vh] translate-y-[20vh] ml-10"><Image src={pokemon?.sprites.other.showdown.front_default} alt="pokemon" width={200} height={100}></Image></div>


      <div className=" flex flex-row bg-gradient-to-r from-blue-400 to-blue-600 rounded-md p-5 w-fit  ml-5 gap-4 border-2 border-green-900">
        <h1 className="font-bold text-3xl">{pokemon?.id}</h1>
<h1 className="font-bold text-3xl">{pokemon?.name}</h1>
      </div>

      <div className=" w-fit mt-10 ml-5 gap-4 bg-gradient-to-r from-blue-400 to-blue-600 rounded-md p-5 border-2 border-green-900">
        type : {pokemon?.types[0]?.type?.name}
        </div>


<div className="mt-5 ml-10 gap-4   bg-gradient-to-r from-blue-400 to-blue-600 rounded-md p-5 rounded-md w-fit border-2 border-green-900 border-2 border-green-900">
<div className="flex flex-row gap-4">
<div className="flex flex-col">
<h1>Height :</h1>
<h1>Weight :</h1>
</div>
<div className="flex flex-col mr-5 ">
<h1>         {pokemon?.height} F</h1>
<h1>      {pokemon?.weight}lbs</h1>
</div>
</div>


 </div>

   
    </div>
    <div className="flex justify-center mt-5 ">
        <input
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          placeholder="Search for a Pokemon"
          className=" rounded-md border border-gray-300 px-20"
        />
        <button onClick={FetchPokemon} type="submit" className="bg-blue-400  px-3 rounded-md">Search</button>
       </div>
    </div>
 
  );}
